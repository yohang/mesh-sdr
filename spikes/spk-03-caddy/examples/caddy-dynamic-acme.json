{
  "admin": {
    "config": {
      "persist": false
    },
    "disabled": true
  },
  "apps": {
    "http": {
      "https_port": 443,
      "servers": {
        "rx": {
          "automatic_https": {
            "disable_redirects": true
          },
          "listen": [
            ":443"
          ],
          "protocols": [
            "h1",
            "h2"
          ],
          "routes": [
            {
              "handle": [
                {
                  "@id": "node-routes",
                  "handler": "subroute",
                  "routes": [
                    {
                      "@id": "node-dynamic",
                      "handle": [
                        {
                          "handler": "vars",
                          "rx_node": "{http.request.uri.path.1}"
                        },
                        {
                          "handler": "headers",
                          "request": {
                            "delete": [
                              "X-Rx-Access-Token",
                              "X-Rx-Node-Id",
                              "X-Rx-Cid"
                            ]
                          }
                        },
                        {
                          "handle_response": [
                            {
                              "match": {
                                "status_code": [
                                  2
                                ]
                              },
                              "routes": [
                                {
                                  "handle": [
                                    {
                                      "handler": "headers",
                                      "request": {
                                        "set": {
                                          "X-Rx-Access-Token": [
                                            "{http.reverse_proxy.header.X-Rx-Access-Token}"
                                          ],
                                          "X-Rx-Cid": [
                                            "{http.reverse_proxy.header.X-Rx-Cid}"
                                          ]
                                        }
                                      }
                                    }
                                  ]
                                }
                              ]
                            }
                          ],
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Forwarded-Method": [
                                  "{http.request.method}"
                                ],
                                "X-Forwarded-Uri": [
                                  "{http.request.uri}"
                                ]
                              }
                            }
                          },
                          "rewrite": {
                            "method": "GET",
                            "uri": "/internal/gateway/authz?node={http.vars.rx_node}"
                          },
                          "upstreams": [
                            {
                              "dial": "unix//run/meshsdr/hub-authz.sock"
                            }
                          ]
                        },
                        {
                          "handler": "rewrite",
                          "uri": "/ws"
                        },
                        {
                          "dynamic_upstreams": {
                            "name": "nodes",
                            "source": "meshsdr_nodes"
                          },
                          "flush_interval": -1,
                          "handler": "reverse_proxy",
                          "headers": {
                            "request": {
                              "set": {
                                "X-Rx-Node-Id": [
                                  "{http.vars.rx_node}"
                                ]
                              }
                            }
                          },
                          "stream_close_delay": "2h0m0s",
                          "stream_timeout": "24h0m0s",
                          "transport": {
                            "dial_timeout": "3s",
                            "protocol": "http",
                            "tls": {
                              "ca": {
                                "pem_files": [
                                  "/etc/meshsdr/tls/hub-ca.pem"
                                ],
                                "provider": "file"
                              },
                              "client_certificate_file": "/etc/meshsdr/tls/gateway.crt",
                              "client_certificate_key_file": "/etc/meshsdr/tls/gateway.key",
                              "server_name": "{http.vars.rx_node}.nodes.rx.internal"
                            },
                            "versions": [
                              "1.1"
                            ]
                          }
                        }
                      ],
                      "match": [
                        {
                          "path_regexp": {
                            "pattern": "^/nodes/[a-z0-9][a-z0-9-]{1,62}/ws$"
                          }
                        }
                      ],
                      "terminal": true
                    }
                  ]
                }
              ]
            },
            {
              "handle": [
                {
                  "handler": "static_response",
                  "status_code": 404
                }
              ],
              "match": [
                {
                  "path": [
                    "/nodes/*"
                  ]
                }
              ],
              "terminal": true
            },
            {
              "handle": [
                {
                  "handler": "meshsdr_hub",
                  "name": "hub"
                }
              ]
            }
          ],
          "tls_connection_policies": [
            {}
          ]
        }
      }
    },
    "tls": {
      "automation": {
        "policies": [
          {
            "issuers": [
              {
                "ca": "https://acme-v02.api.letsencrypt.org/directory",
                "email": "ops@example.org",
                "module": "acme"
              }
            ],
            "subjects": [
              "sdr.example.org"
            ]
          }
        ]
      },
      "certificates": {
        "automate": [
          "sdr.example.org"
        ]
      }
    }
  },
  "logging": {
    "logs": {
      "default": {
        "encoder": {
          "format": "json"
        },
        "level": "DEBUG",
        "writer": {
          "name": "log",
          "output": "slog"
        }
      }
    },
    "sink": {
      "writer": {
        "name": "log",
        "output": "slog"
      }
    }
  },
  "storage": {
    "module": "file_system",
    "root": "/data/caddy"
  }
}
