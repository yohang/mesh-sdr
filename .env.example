# Host port published by compose (mapped to gateway.http_listen, 8073 in the
# dev container)
HTTP_PORT=3000

# Only for the prod image without the dev override
# (docker compose -f compose.yaml up): hub.url is required, and the gateway
# defaults to ACME on :443. For a local plain-HTTP run on the published port:
# MESHSDR_HUB__URL=http://localhost:3000
# MESHSDR_HUB__ALLOW_INSECURE_URL=true
# MESHSDR_GATEWAY__TLS_MODE=off
# MESHSDR_GATEWAY__HTTP_LISTEN=:8073

# Development mail relay (docker compose --profile mail up -d mailpit; web UI
# on http://localhost:8025). Plain-text SMTP is refused unless allowed.
# MESHSDR_SMTP__HOST=mailpit
# MESHSDR_SMTP__PORT=1025
# MESHSDR_SMTP__TLS=none
# MESHSDR_SMTP__ALLOW_INSECURE=true
# MESHSDR_SMTP__FROM=MeshSDR dev <hub@localhost>
