package layout

import "strconv"

// Title is the h1 of a page; id, when set, names it for aria-labelledby.
templ Title(id string) {
	<h1
		class="text-2xl font-semibold"
		if id != "" {
			id={ id }
		}
	>
		{ children... }
	</h1>
}

// Notice confirms an action (a status message); "" shows nothing. id,
// when set, lets a control describe itself with it.
templ Notice(id, text string) {
	if text != "" {
		<p
			class="font-semibold text-success"
			role="status"
			if id != "" {
				id={ id }
			}
		>{ text }</p>
	}
}

// Failure tells that an action failed (an alert); "" shows nothing. id,
// when set, lets a control describe itself with it.
templ Failure(id, text string) {
	if text != "" {
		<p
			class="rounded border border-danger p-3 font-semibold text-danger"
			role="alert"
			if id != "" {
				id={ id }
			}
		>{ text }</p>
	}
}

// ErrorSummary lists the problems of a refused form, each linked to its
// field when it has one; no problem shows nothing.
templ ErrorSummary(heading string, problems []Problem) {
	if len(problems) > 0 {
		<div class="rounded border border-danger p-3" role="alert" tabindex="-1">
			<p class="font-semibold text-danger">{ heading }</p>
			<ul class="mt-1 list-disc pl-5">
				for _, p := range problems {
					<li>
						if p.ID != "" {
							<a href={ templ.SafeURL("#" + p.ID) }>{ p.Text }</a>
						} else {
							{ p.Text }
						}
					</li>
				}
			</ul>
		</div>
	}
}

// DeleteConfirm is the page that confirms a deletion without JavaScript:
// its title, the failure of a refused attempt, the consequences
// (children), and the form posting the version read to action, with a
// link back to cancel.
templ DeleteConfirm(name, failure, action string, version int, button, cancel string) {
	@Title("") {
		Delete { name }
	}
	@Failure("", failure)
	{ children... }
	<form class="flex flex-wrap items-center gap-4" method="post" action={ templ.URL(action) }>
		<input type="hidden" name="version" value={ strconv.Itoa(version) }/>
		<button type="submit" class="rounded border border-danger px-3 py-1 font-semibold text-danger">{ button }</button>
		<a href={ templ.URL(cancel) }>Cancel</a>
	</form>
}

// Pager links the pages of a list around the current one; a single page
// shows nothing.
templ Pager(p Paging) {
	if p.Page > 1 || p.More {
		<nav aria-label={ p.Label } class="flex flex-wrap items-center gap-4">
			if p.Page > 1 {
				<a href={ templ.URL(p.URL(p.Page - 1)) }>{ p.Prev }</a>
			}
			<span class="text-fg-muted">Page { strconv.Itoa(p.Page) }</span>
			if p.More {
				<a href={ templ.URL(p.URL(p.Page + 1)) }>{ p.Next }</a>
			}
		</nav>
	}
}

// FilterInput is a filter of a list (a GET form, id filter-<name>): kind
// is "number" (a frequency in kHz) or "datetime-local" (UTC, to the
// minute). failure is the error of the value typed.
templ FilterInput(name, label, kind, value, failure string) {
	<div class="flex flex-col gap-1">
		<label for={ "filter-" + name } class="font-medium">{ label }</label>
		<input
			id={ "filter-" + name }
			name={ name }
			value={ value }
			type={ kind }
			if kind == "number" {
				min="0"
				step="any"
				inputmode="decimal"
				class="w-40 rounded border border-border px-2 py-1"
			} else {
				class="rounded border border-border px-2 py-1"
			}
			if failure != "" {
				aria-invalid="true"
				aria-describedby={ "filter-" + name + "-error" }
			}
		/>
		if failure != "" {
			<p id={ "filter-" + name + "-error" } class="text-sm font-semibold text-danger">{ failure }</p>
		}
	</div>
}
