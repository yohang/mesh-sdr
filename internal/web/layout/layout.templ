package layout

import "strconv"

// Document is the full app shell page: head, top bar, the #main region and the
// footer. Boosted navigation (hx-boost on <body>, ADR 0003 §1A) fetches the
// full page, keeps only its #main (select) and replaces the current #main
// (outerHTML), so everything outside #main (top bar, shell modules such as the
// audio engine, the live region) survives client-side navigation. Back/forward
// restores only the [hx-history-elt] element.
//
// The top bar holds the logo and site name, the section nav (a bottom tab bar
// below 768 px), the UTC clock, the notifications area and the user menu
// (UI-006, UI-010).
templ Document(s Shell, p Page, content templ.Component) {
	<!DOCTYPE html>
	<html lang="en" data-theme={ string(s.Theme) }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1"/>
			<meta name="color-scheme" content={ s.Theme.ColorScheme() }/>
			if s.Theme == ThemeAuto {
				<meta name="theme-color" content={ ThemeColorLight } media="(prefers-color-scheme: light)"/>
				<meta name="theme-color" content={ ThemeColorDark } media="(prefers-color-scheme: dark)"/>
			} else {
				<meta name="theme-color" content={ s.Theme.ThemeColor() }/>
			}
			<title>{ s.DocumentTitle(p) }</title>
			<link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48"/>
			<link rel="icon" href="/static/icons/icon.svg" type="image/svg+xml"/>
			<link rel="apple-touch-icon" href="/static/icons/apple-touch-icon.png"/>
			<link rel="manifest" href="/manifest.webmanifest"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/vendor/htmx.min.js" nonce={ templ.GetNonce(ctx) } defer></script>
			<script src="/static/js/shell.js" type="module" nonce={ templ.GetNonce(ctx) }></script>
		</head>
		<body
			class="flex min-h-dvh flex-col bg-bg pb-16 text-fg antialiased md:pb-0"
			data-shortcuts={ s.ShortcutsAttr() }
			hx-boost:inherited='target:"#main" select:"#main" swap:"outerHTML"'
		>
			<a href="#main" class="skip-link">Skip to main content</a>
			<header class="sticky top-0 z-10 border-b border-border bg-surface">
				<div class="mx-auto flex h-14 max-w-screen-2xl items-center gap-4 px-4">
					<a href="/" class="flex min-w-0 items-center gap-2 font-semibold tracking-tight text-fg no-underline">
						<img src="/static/icons/icon.svg" alt="" width="28" height="28" class="size-7 shrink-0"/>
						<span class="truncate">{ s.SiteName }</span>
					</a>
					@mainNav(s.Nav, p.Section)
					<div class="ml-auto flex items-center gap-3 text-sm">
						<msdr-utc-clock class="whitespace-nowrap font-mono tabular-nums text-fg-muted">
							<time datetime={ s.ClockDateTime() }>{ s.ClockText() }</time> UTC
						</msdr-utc-clock>
						if s.HelpURL != "" {
							<a
								href={ templ.URL(s.HelpURL) }
								target="_blank"
								rel="noopener noreferrer"
								hx-boost="false"
								class="icon-button"
								data-shortcut="h"
								aria-label="Help (opens in a new tab)"
								aria-keyshortcuts="h"
							>
								@icon() {
									<circle cx="12" cy="12" r="9"></circle>
									<path d="M9.5 9.5a2.5 2.5 0 1 1 3.5 2.3c-.6.3-1 .9-1 1.6v.6M12 17h.01"></path>
								}
							</a>
						}
						@notifications()
						@userMenu(s)
					</div>
				</div>
				// Audio controls of the receiver engine (static/js/receiver/dock.js),
				// outside #main so audio survives navigation; shown while listening.
				<msdr-audio-dock class="block border-t border-border" hidden></msdr-audio-dock>
			</header>
			<div id="msdr-session-ended" class="border-b border-warning bg-surface px-4 py-2" role="alert" hidden>
				<p class="mx-auto max-w-screen-2xl">
					Your session has ended. <a href="" hx-boost="false">Reload the page</a> to continue.
				</p>
			</div>
			<div id="msdr-events-stopped" class="border-b border-warning bg-surface px-4 py-2" role="status" hidden>
				<p class="mx-auto max-w-screen-2xl">
					Live updates stopped: the hub could not be reached. <a href="" hx-boost="false">Reload the page</a> to resume them.
				</p>
			</div>
			@mainRegion(p, content)
			<footer class="border-t border-border bg-surface px-4 py-3 text-sm text-fg-muted">
				<ul class="mx-auto flex max-w-screen-2xl flex-wrap gap-x-4 gap-y-1">
					for _, l := range s.FooterLinks {
						<li>@link(l, "")</li>
					}
					if s.Product.Name != "" {
						<li>{ s.Product.Name } { s.Product.Version } · { s.Product.License }</li>
						<li><a href={ templ.URL(s.Product.SourceURL) } rel="noopener noreferrer" hx-boost="false">Source code</a></li>
					}
				</ul>
			</footer>
			<div id="msdr-announcer" class="sr-only" aria-live="polite" aria-atomic="true"></div>
			@toasts()
			@confirmDialog()
		</body>
	</html>
}

// mainNav is the section navigation (UI-006): inline in the top bar from 768
// px, a bottom tab bar below (CSS only, ADR 0003). Labels stay visible next
// to the icons, so the icons are decorative. static/js/navigation.js keeps
// aria-current in sync after boosted navigation.
templ mainNav(nav []Link, current string) {
	if len(nav) > 0 {
		<nav
			aria-label="Main"
			class="fixed inset-x-0 bottom-0 z-10 border-t border-border bg-surface md:static md:border-0 md:bg-transparent"
		>
			<ul class="flex h-16 items-stretch justify-around md:h-14 md:justify-start md:gap-1">
				for _, l := range nav {
					<li class="flex flex-1 md:flex-none">
						<a
							href={ templ.URL(l.Href) }
							data-section={ l.Section }
							class="nav-link"
							if l.Section != "" && l.Section == current {
								aria-current="page"
							}
							if l.Section == SectionFiles {
								data-shortcut="f"
								data-shortcut-label="Open Files"
								aria-keyshortcuts="f"
							}
						>
							@sectionIcon(l.Section)
							<span>{ l.Label }</span>
						</a>
					</li>
				}
			</ul>
		</nav>
	}
}

// notifications is the notifications area (UI-006, UI-011): a bell that
// opens the list of the session's notifications, newest first, filled by
// static/js/notify.js (which also sets the unread count in the bell's
// name and badge).
templ notifications() {
	<button id="msdr-bell" type="button" popovertarget="msdr-notifications" class="icon-button relative" aria-label="Notifications">
		@icon() {
			<path d="M6 16v-5a6 6 0 0 1 12 0v5l2 2H4zM10 21a2 2 0 0 0 4 0"></path>
		}
		<span id="msdr-bell-count" class="bell-count" aria-hidden="true" hidden></span>
	</button>
	<div id="msdr-notifications" popover class="menu-popover">
		<div class="flex items-center justify-between gap-2">
			<p class="font-semibold">Notifications</p>
			<button id="msdr-notifications-clear" type="button" class="rounded border border-border px-2 py-1 text-xs" hidden>Clear</button>
		</div>
		<p id="msdr-notifications-empty" class="mt-1 text-fg-muted">No notifications.</p>
		<ol id="msdr-notifications-list" class="mt-2 flex max-h-80 flex-col gap-2 overflow-y-auto"></ol>
	</div>
}

// toasts is the toast region (UI-011, static/js/notify.js): top right from
// 768 px, at the bottom (over the tab bar) below. Errors are announced
// assertively and stay until dismissed; the others politely.
templ toasts() {
	<div id="msdr-toasts" class="toast-region">
		<div id="msdr-toasts-alert" class="flex flex-col gap-2" aria-live="assertive" aria-relevant="additions"></div>
		<div id="msdr-toasts-polite" class="flex flex-col gap-2" aria-live="polite" aria-relevant="additions"></div>
	</div>
}

// confirmDialog is the one modal of the app (UI-012, static/js/confirm.js):
// consequential actions only. Its text is set with textContent.
templ confirmDialog() {
	<dialog id="msdr-confirm" class="confirm-dialog" aria-labelledby="msdr-confirm-title" aria-describedby="msdr-confirm-message">
		<h2 id="msdr-confirm-title" class="text-lg font-semibold" data-confirm-title>Please confirm</h2>
		<p id="msdr-confirm-message" class="mt-2" data-confirm-message></p>
		<div class="mt-4 flex flex-wrap justify-end gap-2">
			<button type="button" class="button" data-confirm-cancel>Cancel</button>
			<button type="button" class="button button-primary" data-confirm-ok>Confirm</button>
		</div>
	</dialog>
}

// userMenu is the user menu (UI-010): a "Sign in" link and a "Keyboard
// shortcuts" button for anonymous visitors (no sign-up: accounts are by
// invitation), otherwise a button opening the menu with the name and role,
// the account links, "Keyboard shortcuts", the usage policy and "Sign
// out". Menus are native popovers (Esc and outside clicks close them); sign
// out is a POST answered with a full page load.
templ userMenu(s Shell) {
	if s.User == nil {
		@shortcutsLink("icon-button") {
			<span class="sr-only">Keyboard shortcuts</span>
			@icon() {
				<rect x="2" y="6" width="20" height="12" rx="2"></rect>
				<path d="M6 10h.01M10 10h.01M14 10h.01M18 10h.01M7 14h10"></path>
			}
		}
		<a href="/login" class="font-medium">Sign in</a>
	} else {
		<button type="button" popovertarget="msdr-user-menu" class="icon-button gap-1.5">
			@icon() {
				<circle cx="12" cy="8" r="4"></circle>
				<path d="M4 21a8 8 0 0 1 16 0"></path>
			}
			<span class="sr-only">Account menu for </span>
			<span class="sr-only md:not-sr-only md:max-w-40 md:truncate">{ s.User.Name }</span>
		</button>
		<div id="msdr-user-menu" popover class="menu-popover">
			<p class="flex flex-wrap items-center gap-2">
				<span class="font-semibold">{ s.User.Name }</span>
				<span class="badge">{ s.User.Role }</span>
			</p>
			<ul class="mt-2 flex flex-col">
				for _, l := range s.User.Links {
					<li><a href={ templ.URL(l.Href) } class="menu-item">{ l.Label }</a></li>
				}
				<li>
					@shortcutsLink("menu-item") {
						Keyboard shortcuts
					}
				</li>
				for _, l := range s.FooterLinks {
					<li>@link(l, "menu-item")</li>
				}
				<li>
					<form method="post" action="/logout">
						<button type="submit" class="menu-item">Sign out</button>
					</form>
				</li>
			</ul>
		</div>
	}
}

// shortcutsLink opens the keyboard shortcuts help (UI-015): on the Receiver
// page, static/js/shortcuts.js shows it docked in the side panel (or the
// bottom sheet); elsewhere the link opens the Receiver with that view.
templ shortcutsLink(class string) {
	<a href="/?panel=shortcuts" class={ class } data-shortcuts-help aria-keyshortcuts="?">
		{ children... }
	</a>
}

// link renders a link; an external one opens in a new tab, which its name
// says.
templ link(l Link, class string) {
	if l.External {
		<a
			href={ templ.URL(l.Href) }
			if class != "" {
				class={ class }
			}
			target="_blank"
			rel="noopener noreferrer"
			hx-boost="false"
		>{ l.Label }<span class="sr-only">{ " (opens in a new tab)" }</span></a>
	} else {
		<a
			href={ templ.URL(l.Href) }
			if class != "" {
				class={ class }
			}
		>{ l.Label }</a>
	}
}

// mainRegion is the region swapped by boosted navigation. It carries the page
// section for the nav's aria-current, and is focused after navigation
// (static/js/navigation.js).
templ mainRegion(p Page, content templ.Component) {
	<main
		id="main"
		tabindex="-1"
		hx-history-elt
		data-section={ p.Section }
		class="mx-auto w-full max-w-screen-2xl flex-1 px-4 py-6 focus:outline-none"
	>
		@content
	</main>
}

// Error is the content of an error page (403, 404, 500…), rendered inside the
// shell: htmx swaps error responses into #main too.
templ Error(status int, title, message string) {
	@Title("") {
		{ title }
	}
	<p class="mt-2 text-fg-muted">{ message }</p>
	<p class="mt-4 text-sm text-fg-muted">HTTP { strconv.Itoa(status) } · <a href="/">Back to the home page</a></p>
}
