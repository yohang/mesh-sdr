package http

import "strconv"

// imagesSection is the receiver images section of the admin Site page
// (ADM-004), also returned alone (htmx fragment) after an action.
templ imagesSection(slots []slotView, notice, failure string) {
	<section id="receiver-images" class="flex flex-col gap-4 rounded border border-border bg-surface p-4" aria-labelledby="title-images">
		<h2 id="title-images" class="text-lg font-semibold">Images</h2>
		<p class="text-sm text-fg-muted">PNG, JPEG or WebP, at most 8192 × 8192 pixels. Images are re-encoded (avatar as PNG, panorama as JPEG), which removes their metadata.</p>
		if notice != "" {
			<p class="font-semibold text-success" role="status">{ notice }</p>
		}
		if failure != "" {
			<p class="font-semibold text-danger" role="alert">{ failure }</p>
		}
		for _, s := range slots {
			<div class="flex flex-col gap-2">
				<h3 class="font-semibold">{ s.Label }</h3>
				if s.Set {
					<img src={ s.Src } alt={ "Current " + s.Label } width={ strconv.Itoa(s.Width) } height={ strconv.Itoa(s.Height) } class="h-auto max-h-48 w-auto max-w-full rounded border border-border"/>
					<p class="text-sm text-fg-muted">{ s.FileName }, { strconv.Itoa(s.Width) } × { strconv.Itoa(s.Height) } pixels.</p>
				} else {
					<p class="text-sm text-fg-muted">No image: the default applies.</p>
				}
				<form method="post" action="/admin/site/images" enctype="multipart/form-data" hx-post="/admin/site/images" hx-encoding="multipart/form-data" hx-target="#receiver-images" hx-swap="outerHTML" class="flex flex-wrap items-end gap-2">
					<input type="hidden" name="slot" value={ s.Slot.Name() }/>
					<label class="flex flex-col gap-1">
						<span>New { s.Label } (at most { s.Limit })</span>
						<input type="file" name="file" accept="image/png,image/jpeg,image/webp" required/>
					</label>
					<button type="submit" class="rounded bg-accent px-3 py-1 font-semibold text-accent-fg">Upload<span class="sr-only"> { s.Label }</span></button>
				</form>
				if s.Set {
					<form method="post" action="/admin/site/images/remove" hx-post="/admin/site/images/remove" hx-target="#receiver-images" hx-swap="outerHTML" hx-confirm={ "Remove the " + s.Slot.Name() + " and restore the default?" }>
						<input type="hidden" name="slot" value={ s.Slot.Name() }/>
						<button type="submit" class="rounded border border-border px-3 py-1">Restore default<span class="sr-only"> { s.Label }</span></button>
					</form>
				}
			</div>
		}
	</section>
}
