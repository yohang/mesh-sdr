package http

import (
	"strconv"

	"github.com/yohang/mesh-sdr/internal/grid/domain"
	"github.com/yohang/mesh-sdr/internal/web/layout"
)

// devicesPage lists the device registry, read-only (devices are configured
// in their node config, ADM-007). Devices of offline nodes are muted and
// say so in text.
templ devicesPage(rows []deviceListRow) {
	@layout.Title("") {
		Devices
	}
	<p class="text-fg-muted">Devices are configured only in the node config of their node: this registry is read-only.</p>
	@devicesTable(rows)
}

// devicesTable is the live part of the device list, also its htmx fragment
// (same URL): it refetches itself when a device or a node changes, or after
// the hub events socket (re)subscribed (ADR 0016).
templ devicesTable(rows []deviceListRow) {
	<div
		id="devices-table"
		data-msdr-topics="devices nodes"
		hx-get="/admin/devices"
		hx-trigger="msdr:device.status from:body delay:1s, msdr:node.status from:body delay:1s, msdr:resync from:body"
		hx-swap="outerMorph"
	>
		if len(rows) == 0 {
			<p>No device has been reported yet.</p>
		} else {
			@layout.TableScroll("Device registry") {
				<table class="w-full text-left">
					<caption class="sr-only">Device registry</caption>
					<thead>
						<tr class="border-b border-border">
							<th scope="col" class="py-1 pr-4">Node</th>
							<th scope="col" class="py-1 pr-4">Device id</th>
							<th scope="col" class="py-1 pr-4">Name</th>
							<th scope="col" class="py-1 pr-4">Type</th>
							<th scope="col" class="py-1 pr-4">Frequency range</th>
							<th scope="col" class="py-1 pr-4">State</th>
							<th scope="col" class="py-1 pr-4">Active preset</th>
							<th scope="col" class="py-1">Listeners</th>
						</tr>
					</thead>
					<tbody>
						for _, row := range rows {
							<tr class={ "border-b border-border", templ.KV("text-fg-muted", !row.NodeUp) }>
								<td class="py-1 pr-4">{ row.Device.Node().String() }</td>
								<td class="py-1 pr-4 font-mono">{ row.Device.ID().String() }</td>
								<th scope="row" class="py-1 pr-4 font-medium">
									<a href={ templ.URL("/admin/devices/" + row.Device.ID().String()) }>{ row.Device.Name() }</a>
								</th>
								<td class="py-1 pr-4">{ row.Device.Type() }</td>
								<td class="py-1 pr-4">{ layout.FormatHz(minFreq(row.Device)) } – { layout.FormatHz(maxFreq(row.Device)) }</td>
								<td class="py-1 pr-4">
									if since, ok := missing(row.Device); ok {
										no longer reported since { since }
									} else {
										{ state(row.Device) }
									}
									if !row.NodeUp {
										(node offline)
									}
								</td>
								<td class="py-1 pr-4">
									if row.ActivePreset != "" {
										{ row.ActivePreset }
									} else {
										None
									}
								</td>
								<td class="py-1">{ strconv.Itoa(row.Listeners) }</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}

func minFreq(d *domain.Device) int64 { lo, _ := d.FreqRange(); return lo }

func maxFreq(d *domain.Device) int64 { _, hi := d.FreqRange(); return hi }

// devicePage is the device detail (ADM-008): the device definition from
// its node config, read-only, and "forget" for a missing device (ADM-009,
// admins only).
templ devicePage(v deviceView) {
	@layout.Title("") {
		{ v.Device.Name() }
	}
	<p class="text-fg-muted">Defined in the node config of { v.NodeName } (node { v.Device.Node().String() }). Edit that file to change the device: this page is read-only.</p>
	if v.CanAdmin {
		<p><a href={ templ.URL("/admin/devices/" + v.Device.ID().String() + "/log") }>Device log</a></p>
	}
	@layout.Failure("", v.Failure)
	if since, ok := missing(v.Device); ok {
		<section class="flex flex-col gap-2 rounded border border-warning p-4" aria-labelledby="title-missing">
			<h2 id="title-missing" class="text-lg font-semibold">No longer reported</h2>
			<p>The node has reported its devices without this one since { since }: it was removed from the node config.</p>
			if v.CanAdmin {
				<form method="post" action={ templ.SafeURL("/admin/devices/" + v.Device.ID().String() + "/forget") } hx-post={ "/admin/devices/" + v.Device.ID().String() + "/forget" } hx-confirm={ "Forget " + v.Device.Name() + "? Its registry entry is deleted; presets are not affected." } data-confirm-action="Forget the device">
					<button type="submit" class="rounded border border-border px-3 py-1">Forget this device</button>
				</form>
			}
		</section>
	}
	<section class="flex flex-col gap-2 rounded border border-border bg-surface p-4" aria-labelledby="title-definition">
		<h2 id="title-definition" class="text-lg font-semibold">Definition</h2>
		<dl class="grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-[max-content_1fr]">
			<dt class="font-medium">Device id</dt>
			<dd class="font-mono">{ v.Device.ID().String() }</dd>
			<dt class="font-medium">Type</dt>
			<dd>{ v.Device.Type() }</dd>
			<dt class="font-medium">Enabled</dt>
			<dd>{ yesNo(v.Device.Flags().Enabled) }</dd>
			<dt class="font-medium">Frequency range</dt>
			<dd>{ layout.FormatHz(minFreq(v.Device)) } – { layout.FormatHz(maxFreq(v.Device)) }</dd>
			<dt class="font-medium">Sample rates</dt>
			<dd>{ sampleRates(v.Device.SampleRates()) }</dd>
			<dt class="font-medium">Always on</dt>
			<dd>{ yesNo(v.Device.Flags().AlwaysOn) }</dd>
			<dt class="font-medium">Scheduler enabled</dt>
			<dd>{ yesNo(v.Device.Flags().SchedulerEnabled) }</dd>
		</dl>
	</section>
	<section class="flex flex-col gap-2 rounded border border-border bg-surface p-4" aria-labelledby="title-config">
		<h2 id="title-config" class="text-lg font-semibold">Node config values</h2>
		<p class="text-fg-muted">Set in node config: read-only here. Edit the node config of { v.NodeName } to change them.</p>
		<dl class="grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-[max-content_1fr]">
			<dt class="font-medium">Listen policy</dt>
			<dd>{ listenPolicy(v.Device.Flags().ListenPolicy) }</dd>
			<dt class="font-medium">Operators can retune</dt>
			<dd>{ yesNo(v.Device.Flags().OperatorCanRetune) }</dd>
			if c, ok := v.Device.Config(); ok {
				<dt class="font-medium">RF gain</dt>
				<dd>{ rfGain(c.RFGain) }</dd>
				<dt class="font-medium">Frequency correction</dt>
				<dd>{ strconv.Itoa(c.PPM) } ppm</dd>
				<dt class="font-medium">Bias-tee</dt>
				<dd>{ onOff(c.BiasTee) }</dd>
				<dt class="font-medium">Direct sampling</dt>
				<dd>{ directSampling(c.DirectSampling) }</dd>
				<dt class="font-medium">IQ swap</dt>
				<dd>{ onOff(c.IQSwap) }</dd>
				<dt class="font-medium">Converter offset</dt>
				<dd>{ lfoOffset(c.LFOOffset) }</dd>
			}
		</dl>
		if _, ok := v.Device.Config(); !ok {
			<p>The node does not report the driver values of this device.</p>
		}
	</section>
	<section class="flex flex-col gap-2 rounded border border-border bg-surface p-4" aria-labelledby="title-state">
		<h2 id="title-state" class="text-lg font-semibold">State</h2>
		<dl class="grid grid-cols-1 gap-x-6 gap-y-1 sm:grid-cols-[max-content_1fr]">
			<dt class="font-medium">State</dt>
			<dd>{ state(v.Device) }</dd>
			<dt class="font-medium">Online</dt>
			<dd>{ yesNo(v.Device.Online()) }</dd>
			if f := v.Device.CenterFreq(); f != nil {
				<dt class="font-medium">Centre frequency</dt>
				<dd>{ layout.FormatHz(*f) }</dd>
			}
			<dt class="font-medium">Active preset</dt>
			<dd>
				if v.ActivePreset != "" {
					{ v.ActivePreset }
				} else {
					None
				}
			</dd>
			<dt class="font-medium">Last report</dt>
			<dd>{ utc(v.Device.ReportedAt()) }</dd>
			<dt class="font-medium">Position in the node config</dt>
			<dd>{ strconv.Itoa(v.Device.SortOrder() + 1) }</dd>
		</dl>
	</section>
	<section class="flex flex-col gap-2 rounded border border-border bg-surface p-4" aria-labelledby="title-schedules">
		<h2 id="title-schedules" class="text-lg font-semibold">Schedules</h2>
		if !v.Device.Flags().SchedulerEnabled {
			<p class="text-fg-muted">The node config does not enable the scheduler on this device: its schedules do not run.</p>
		}
		switch {
			case v.SchedulesUnavailable:
				<p>The schedules could not be read. Try again later.</p>
			case len(v.Schedules) == 0:
				<p>No schedule drives this device.</p>
			default:
				@layout.TableScroll("Schedules of " + v.Device.Name()) {
					<table class="w-full text-left">
						<caption class="sr-only">Schedules of { v.Device.Name() }, in UTC</caption>
						<thead>
							<tr>
								<th scope="col" class="pr-4">Window</th>
								<th scope="col" class="pr-4">Days</th>
								<th scope="col" class="pr-4">Preset</th>
								<th scope="col" class="pr-4">Priority</th>
								<th scope="col">State</th>
							</tr>
						</thead>
						<tbody>
							for _, s := range v.Schedules {
								<tr>
									<td class="pr-4">{ s.Window }</td>
									<td class="pr-4">{ s.Days }</td>
									<td class="pr-4">{ s.Preset }</td>
									<td class="pr-4">{ strconv.Itoa(s.Priority) }</td>
									<td>
										switch {
											case s.Enabled:
												Enabled
											case s.DisabledReason != "":
												<span class="font-semibold text-danger">Disabled by the hub on { utc(s.DisabledAt) }: { disabledReason(s.DisabledReason) }.</span> An admin re-enables it once fixed.
											default:
												Disabled
										}
									</td>
								</tr>
							}
						</tbody>
					</table>
				}
		}
	</section>
}
