package presets

import (
	"strconv"

	"github.com/yohang/mesh-sdr/internal/web/layout"
	"github.com/yohang/mesh-sdr/internal/web/render"
)

// listPage is Admin › Presets: every preset by position, with its band.
templ listPage(list []*Preset, notice string) {
	@layout.Title("") {
		Presets
	}
	<p class="text-fg-muted">A preset tunes a device for every listener: centre frequency, sample rate and the demodulator listeners start with. A device offers only the presets that fit its frequency range and sample rates.</p>
	<p><a class="font-semibold" href="/admin/presets/new">New preset</a></p>
	@presetsList(list, notice)
}

// presetsList is the live part of the page, also the htmx fragment answered
// to a reorder. Reordering changes the display order only: it never changes
// the active preset of a device.
templ presetsList(list []*Preset, notice string) {
	<div id="presets-list" class="flex flex-col gap-3">
		@layout.Notice("", notice)
		if len(list) == 0 {
			<p>No presets yet.</p>
		} else {
			<p class="text-fg-muted">The position sets the order of the receiver's preset list. Drag a row, or use the Move up and Move down buttons.</p>
			@layout.TableScroll("Presets") {
				<table class="w-full text-left">
					<caption class="sr-only">Presets</caption>
					<thead>
						<tr class="border-b border-border">
							<th scope="col" class="py-1 pr-4">Position</th>
							<th scope="col" class="py-1 pr-4">Preset</th>
							<th scope="col" class="py-1 pr-4">Centre</th>
							<th scope="col" class="py-1 pr-4">Sample rate</th>
							<th scope="col" class="py-1 pr-4">Start</th>
							<th scope="col" class="py-1">Actions</th>
						</tr>
					</thead>
					<tbody data-msdr-sortable>
						for i, p := range list {
							<tr id={ "preset-" + p.ID().String() } data-sort-id={ p.ID().String() } draggable="true" class="border-b border-border data-dragging:opacity-50 data-drop:border-t-2 data-drop:border-t-accent">
								<td class="py-1 pr-4">
									{ strconv.Itoa(i + 1) }
									<form class="hidden" method="post" action={ templ.SafeURL(movePath(p)) } hx-post={ movePath(p) } hx-target="#presets-list" hx-swap="outerMorph" data-sort-drop>
										<input type="hidden" name="position" value={ strconv.Itoa(i + 1) }/>
									</form>
								</td>
								<th scope="row" class="py-1 pr-4 font-medium">
									<a href={ templ.URL("/admin/presets/" + p.ID().String()) }>{ p.Name() }</a>
								</th>
								<td class="py-1 pr-4">{ layout.FormatHz(p.CenterFreq()) }</td>
								<td class="py-1 pr-4">{ strconv.FormatInt(p.SampRate(), 10) } S/s</td>
								<td class="py-1 pr-4">{ layout.FormatHz(p.StartFreq()) } { p.StartMod() }</td>
								<td class="py-1">
									<div class="flex flex-wrap items-center gap-3">
										if i > 0 {
											<form method="post" action={ templ.SafeURL(movePath(p)) } hx-post={ movePath(p) } hx-target="#presets-list" hx-swap="outerMorph">
												<input type="hidden" name="direction" value="up"/>
												<button id={ "up-" + p.ID().String() } type="submit" class="underline">Move up<span class="sr-only">{ p.Name() }</span></button>
											</form>
										}
										if i < len(list)-1 {
											<form method="post" action={ templ.SafeURL(movePath(p)) } hx-post={ movePath(p) } hx-target="#presets-list" hx-swap="outerMorph">
												<input type="hidden" name="direction" value="down"/>
												<button id={ "down-" + p.ID().String() } type="submit" class="underline">Move down<span class="sr-only">{ p.Name() }</span></button>
											</form>
										}
										<form method="post" action={ templ.SafeURL("/admin/presets/" + p.ID().String() + "/clone") }>
											<button type="submit" class="underline">Clone<span class="sr-only">{ p.Name() }</span></button>
										</form>
										<a href={ templ.URL("/admin/presets/" + p.ID().String() + "/delete") }>Delete<span class="sr-only">{ p.Name() }</span></a>
									</div>
								</td>
							</tr>
						}
					</tbody>
				</table>
			}
		}
	</div>
}

// fieldNames name the fields in the error summary.
func fieldNames() []render.Field {
	out := make([]render.Field, len(formFields))
	for i, ff := range formFields {
		out[i] = render.Field{Key: ff.Name, Label: ff.Label}
	}

	return out
}

func (f presetForm) action() string {
	if f.ID == "" {
		return "/admin/presets"
	}

	return "/admin/presets/" + f.ID
}

func describedBy(f presetForm, ff formField) string {
	if _, ok := f.Errors[ff.Name]; ok {
		return "help-" + ff.Name + " err-" + ff.Name
	}

	return "help-" + ff.Name
}

func invalid(f presetForm, ff formField) templ.Attributes {
	if _, ok := f.Errors[ff.Name]; ok {
		return templ.Attributes{"aria-invalid": "true"}
	}

	return nil
}

// formPage is the preset form: a new preset, or the edit of one.
templ formPage(f presetForm) {
	@layout.Title("") {
		if f.ID == "" {
			New preset
		} else {
			{ f.Name }
		}
	}
	<p><a href="/admin/presets">All presets</a></p>
	@layout.Notice("", f.Notice)
	@layout.Failure("", f.Failure)
	@layout.ErrorSummary("The preset was not saved:", f.Problems("preset-", fieldNames()))
	<form class="flex max-w-xl flex-col gap-4" method="post" action={ templ.SafeURL(f.action()) } novalidate>
		if f.ID != "" {
			<input type="hidden" name="version" value={ strconv.Itoa(f.Version) }/>
		}
		for _, ff := range formFields {
			<div class="flex flex-col gap-1">
				<label for={ "preset-" + ff.Name } class="font-medium">
					{ ff.Label }
					if !ff.Required {
						<span class="text-sm text-fg-muted">(optional)</span>
					}
				</label>
				<input
					id={ "preset-" + ff.Name }
					name={ ff.Name }
					value={ f.Values[ff.Name] }
					class="rounded border border-border px-2 py-1"
					if ff.Numeric {
						type="number"
						step="1"
						inputmode="numeric"
					} else {
						type="text"
					}
					required?={ ff.Required }
					aria-describedby={ describedBy(f, ff) }
					{ invalid(f, ff)... }
				/>
				<p id={ "help-" + ff.Name } class="text-sm text-fg-muted">{ ff.Help }</p>
				if msg, ok := f.Errors[ff.Name]; ok {
					<p id={ "err-" + ff.Name } class="text-sm font-semibold text-danger">{ msg }</p>
				}
			</div>
		}
		<div class="flex flex-wrap items-center gap-4">
			<button type="submit" class="rounded bg-accent px-3 py-1 font-semibold text-accent-fg">
				if f.ID == "" {
					Create the preset
				} else {
					Save the preset
				}
			</button>
			if f.ID != "" {
				<a href={ templ.URL("/admin/presets/" + f.ID + "/delete") }>Delete this preset</a>
			}
		</div>
	</form>
}

// deletePage asks to confirm the deletion of a preset (ADM-020). Deleting
// never retunes a device; a preset that schedules use is refused.
templ deletePage(p *Preset, failure string) {
	@layout.DeleteConfirm(p.Name(), failure, "/admin/presets/"+p.ID().String()+"/delete", p.Version(), "Delete the preset", "/admin/presets/"+p.ID().String()) {
		<p>Devices tuned to this preset keep their tuning. A preset that schedules use cannot be deleted.</p>
	}
}
