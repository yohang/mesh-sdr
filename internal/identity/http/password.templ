package http

import (
	"strconv"

	"github.com/yohang/mesh-sdr/internal/web/layout"
)

// passwordPage is the password change page (AUTH-006, AUTH-007): the
// interstitial shown after sign-in to a user who must change the password,
// and the voluntary change of a signed-in user.
templ passwordPage(f passwordForm) {
	<section class="mx-auto flex w-full max-w-sm flex-col gap-4 p-4" aria-labelledby="password-title">
		@layout.Title("password-title") {
			Change password
		}
		if f.Forced {
			<p id="password-forced" class="font-semibold">You must choose a new password before you continue.</p>
		}
		if f.Changed {
			@layout.Notice("password-changed", msgPasswordChanged)
		}
		@passwordFormView(f)
	</section>
}

// passwordFormView is the form, also returned alone (htmx fragment) with the
// error after a failed attempt.
templ passwordFormView(f passwordForm) {
	<form id="password-form" class="flex flex-col gap-3" method="post" action="/account/password" hx-post="/account/password" hx-target="this" hx-swap="outerHTML">
		@layout.Failure("password-error", f.Error)
		if f.Forced {
			<input type="hidden" name="next" value={ f.Next }/>
		}
		<label class="flex flex-col gap-1">
			<span>Current password</span>
			<input
				class="rounded border px-2 py-1"
				type="password"
				name="current_password"
				autocomplete="current-password"
				required
				if f.Field == "current" {
					aria-describedby="password-error"
					aria-invalid="true"
				}
			/>
		</label>
		<label class="flex flex-col gap-1">
			<span>New password</span>
			<input
				class="rounded border px-2 py-1"
				type="password"
				name="new_password"
				autocomplete="new-password"
				minlength={ strconv.Itoa(f.MinLength) }
				maxlength="256"
				required
				if f.Field == "new" {
					aria-describedby="password-rules password-error"
					aria-invalid="true"
				} else {
					aria-describedby="password-rules"
				}
			/>
		</label>
		<p id="password-rules" class="text-sm">At least { strconv.Itoa(f.MinLength) } characters. Common passwords are refused.</p>
		<label class="flex flex-col gap-1">
			<span>Repeat the new password</span>
			<input class="rounded border px-2 py-1" type="password" name="confirm_password" autocomplete="new-password" required/>
		</label>
		<button class="rounded border px-3 py-1 font-semibold" type="submit">Change password</button>
	</form>
}
