package http

import (
	"strconv"

	"github.com/yohang/mesh-sdr/internal/web/layout"
)

// forgotPage is the forgot-password page (ACC-003): one answer whatever the
// account (SR-06). Without mail it says to ask an administrator.
templ forgotPage(v forgotView) {
	<section class="mx-auto flex w-full max-w-sm flex-col gap-4 p-4" aria-labelledby="forgot-title">
		@layout.Title("forgot-title") {
			Forgot password
		}
		if v.MailEnabled {
			@forgotFormView(v)
		} else {
			<p>Ask an administrator to reset your password.</p>
		}
		<p><a href="/login">Back to sign in</a></p>
	</section>
}

templ forgotFormView(v forgotView) {
	<form id="forgot-form" class="flex flex-col gap-3" method="post" action="/password/forgot" hx-post="/password/forgot" hx-target="this" hx-swap="outerHTML">
		if v.Sent {
			@layout.Notice("", "If an account matches, we sent a link. It is valid for "+strconv.Itoa(v.Minutes)+" minutes.")
		}
		@layout.Failure("", v.Error)
		<label class="flex flex-col gap-1">
			<span>Username or e-mail</span>
			<input class="rounded border px-2 py-1" type="text" name="login" autocomplete="username" autocapitalize="none" spellcheck="false" required/>
		</label>
		<button class="rounded border px-3 py-1 font-semibold" type="submit">Send reset link</button>
	</form>
}

// resetPage sets a new password from a reset link; the token moves into a
// hidden field (token-url.js, SR-07).
templ resetPage(f resetForm) {
	<section class="mx-auto flex w-full max-w-sm flex-col gap-4 p-4" aria-labelledby="reset-title" data-replace-url="/password/reset">
		@layout.Title("reset-title") {
			Choose a new password
		}
		@resetFormView(f)
	</section>
}

templ resetFormView(f resetForm) {
	<form id="reset-form" class="flex flex-col gap-3" method="post" action="/password/reset" hx-post="/password/reset" hx-target="this" hx-swap="outerHTML">
		@layout.Failure("reset-error", f.Error)
		<input type="hidden" name="token" value={ f.Token }/>
		<label class="flex flex-col gap-1">
			<span>New password</span>
			<input
				class="rounded border px-2 py-1"
				type="password"
				name="password"
				autocomplete="new-password"
				minlength={ strconv.Itoa(f.MinLength) }
				maxlength="256"
				required
				if f.Error != "" {
					aria-describedby="reset-rules reset-error"
					aria-invalid="true"
				} else {
					aria-describedby="reset-rules"
				}
			/>
		</label>
		<p id="reset-rules" class="text-sm">At least { strconv.Itoa(f.MinLength) } characters. Common passwords are refused.</p>
		<label class="flex flex-col gap-1">
			<span>Repeat the new password</span>
			<input class="rounded border px-2 py-1" type="password" name="confirm_password" autocomplete="new-password" required/>
		</label>
		<button class="rounded border px-3 py-1 font-semibold" type="submit">Set password</button>
	</form>
}

templ resetInvalid(msg string) {
	<section class="mx-auto flex w-full max-w-prose flex-col gap-4 p-4" aria-labelledby="reset-title">
		@layout.Title("reset-title") {
			Reset password
		}
		@layout.Failure("", msg)
		<p><a href="/password/forgot">Ask for a new link</a></p>
	</section>
}
