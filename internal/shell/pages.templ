package shell

import "github.com/yohang/mesh-sdr/internal/web/layout"

// receiverPage is the Receiver section: the station, then the receiver
// island (static/js/receiver/island.js, ADR 0015) with its initial state and
// the station identity set on the hub (RX-036: name, location, panorama and
// description), which the island moves into its Info panel (UI-019).
// descHTML is goldmark output, which carries no raw HTML nor dangerous URLs
// (see markdown.go).
templ receiverPage(siteName string, st StationView, descHTML string, rx receiverConfig) {
	<div class="flex items-center gap-3">
		if st.HasAvatar {
			<img src="/api/v1/branding/avatar" alt="" width="48" height="48" class="size-12 rounded-md object-cover"/>
		}
		<div>
			@layout.Title("") {
				{ siteName }
			}
			if st.Location != "" {
				<p class="text-fg-muted">{ st.Location }</p>
			}
		</div>
	</div>
	// The island follows node and device availability, listeners and node
	// telemetry live (hub events, UI-021, GRID-021, RX-035).
	<msdr-receiver class="block" data-msdr-topics="nodes devices">
		@templ.JSONScript("msdr-receiver-config", rx)
		<p class="mt-4 text-fg-muted">The receiver needs JavaScript to play audio and draw the waterfall.</p>
		<div data-rx-station class="mt-4 flex min-w-0 flex-col gap-2 text-sm">
			<h3 class="font-semibold">Station</h3>
			<dl class="grid grid-cols-[auto_1fr] gap-x-3 gap-y-1">
				<dt class="text-fg-muted">Name</dt>
				<dd class="min-w-0 break-words">{ siteName }</dd>
				if st.Location != "" {
					<dt class="text-fg-muted">Location</dt>
					<dd class="min-w-0 break-words">{ st.Location }</dd>
				}
			</dl>
			if st.HasPanorama || st.PhotoTitle != "" || descHTML != "" {
				<figure class="flex flex-col gap-2">
					if st.HasPanorama {
						<img src="/api/v1/branding/panorama" alt={ st.PhotoTitle } class="w-full rounded-md"/>
					}
					if st.PhotoTitle != "" || descHTML != "" {
						<figcaption class="prose-text">
							if st.PhotoTitle != "" {
								<p class="font-semibold">{ st.PhotoTitle }</p>
							}
							@templ.Raw(descHTML)
						</figcaption>
					}
				</figure>
			}
		</div>
	</msdr-receiver>
}

// placeholderPage is a section whose module does not exist yet.
templ placeholderPage(title, notice string) {
	@layout.Title("") {
		{ title }
	}
	<p class="mt-2 text-fg-muted">{ notice }</p>
}

// policyPage renders the usage policy. policyHTML is goldmark output, which
// carries no raw HTML nor dangerous URLs (see markdown.go).
templ policyPage(policyHTML string) {
	<article class="prose-text">
		<h1>Usage policy</h1>
		@templ.Raw(policyHTML)
	</article>
}

// aboutPage shows the running software, where its source code is and the
// station's help link when the hub sets one (RX-038: author, documentation
// and support links live here).
templ aboutPage(p layout.Product, helpURL string) {
	<article class="prose-text">
		<h1>About</h1>
		<dl class="grid grid-cols-[auto_1fr] gap-x-4 gap-y-1">
			if helpURL != "" {
				<dt class="font-semibold">Help</dt>
				<dd>
					<a href={ templ.URL(helpURL) } target="_blank" rel="noopener noreferrer" hx-boost="false">
						{ helpURL }<span class="sr-only">{ " (opens in a new tab)" }</span>
					</a>
				</dd>
			}
			<dt class="font-semibold">Software</dt>
			<dd>{ p.Name }</dd>
			<dt class="font-semibold">Version</dt>
			<dd>{ p.Version }</dd>
			<dt class="font-semibold">Licence</dt>
			<dd>{ p.License }</dd>
			<dt class="font-semibold">Source code</dt>
			<dd><a href={ templ.URL(p.SourceURL) } rel="noopener noreferrer" hx-boost="false">{ p.SourceURL }</a></dd>
		</dl>
		<p>
			{ p.Name } is free software: you can redistribute it and modify it under the terms of the
			GNU Affero General Public License, version 3 or any later version. It comes with no warranty.
			The source code of this version is available at the address above.
		</p>
	</article>
}
