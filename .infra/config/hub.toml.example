# MeshSDR hub configuration: /etc/meshsdr/hub.toml (TECHNICAL_SPEC §7.4).
#
# - TOML v1.0, declarative only. Every file (hub.toml and each hub.d/*.toml
#   drop-in, merged in lexical order) starts with schema_version.
# - Every key can be overridden by an env var: MESHSDR_<TABLE>__<KEY>, for
#   example db.dsn → MESHSDR_DB__DSN. Precedence: env > files > defaults.
#   Keys set in a file or the env are locked and shown with their origin.
# - The config dir is /etc/meshsdr, or --config-dir / MESHSDR_CONFIG_DIR.
# - JSON Schema: `meshsdr hub config schema`. Validate: `meshsdr hub config check`.
# - MESHSDR_PASSWORD is not a config key: it gives the password of
#   `meshsdr --noninteractive hub user add <name>`.
# - Secret keys take { file = "/etc/meshsdr/secrets/x" } or { env = "VAR" };
#   an inline value needs allow_inline_secrets = true in the same file.
#   Secret files must not be group/world-writable nor world-readable.
#
# Values below are the defaults unless marked "required".

schema_version = 1

[hub]
# Hub HTTP listen address (host:port). The address decides IPv4 or IPv6.
listen = "0.0.0.0:8073"
# Public base URL of the hub (required). Must be https unless
# allow_insecure_url = true.
url = "https://sdr.example.org"
# Allow a non-https url (development only).
allow_insecure_url = false

[db]
# Database DSN. Only SQLite is supported: sqlite:///abs/path or
# sqlite:relative/path, on a local filesystem.
dsn = "sqlite:///var/lib/meshsdr/hub.db"
# Size of the read-only connection pool (1..64).
max_read_connections = 4

# Hub internal CA for hub <-> node mTLS (ADR 0008). Create it with
# `meshsdr hub ca init` (writes tls/ca.pem and tls/ca.key in the config dir).
# Relative paths are resolved against the config dir. Without [tls] the hub
# runs with the grid disabled: no enrollment, no control channels.
# [tls]
# ca_cert = "tls/ca.pem"
# ca_key = { file = "tls/ca.key" }

# Nodes declared in the hub config (GRID-004): locked in Admin > Nodes and
# not deletable there. File-only: no env override. A node removed from the
# files becomes an admin-managed node.
# [nodes.attic]
# Base URL the hub dials (required): https://host:port.
# url = "https://10.8.0.12:8074"
# Display name (defaults to the node id).
# name = "Attic"
# Enrollment token (secret): 32 random bytes in unpadded base64url (43
# characters), e.g. `openssl rand -base64 32 | tr +/ -_ | tr -d =`, given to
# `meshsdr node enroll` on the node; used once.
# enrollment_token = { file = "/etc/meshsdr/secrets/node_attic.token" }

[log]
# debug | info | warn | error. --debug overrides it.
level = "info"
# text | json. --json overrides it.
format = "json"

[auth.argon2]
# Argon2id password hashing. Floors: memory_kib >= 19456, iterations >= 2.
# Stored hashes with other parameters are re-hashed at the next login.
memory_kib = 65536
iterations = 3
parallelism = 1

[admin]
# Client networks (CIDR) allowed to use the admin endpoints, checked on every
# admin request against the resolved client address. Default: any.
allowed_networks = ["0.0.0.0/0", "::/0"]

[http]
# Reverse proxies (CIDR) trusted for X-Forwarded-For. The client address is
# the right-most hop that is not a trusted proxy. Default: none.
trusted_proxies = []

# Admin settings (ADR 0010), MESHSDR_SETTINGS__<TABLE>__<KEY>. Each key set
# here or in the env is locked: read-only in the admin UI, which shows its
# origin. Leave a key commented out to keep it admin-editable (DB setting,
# then the default shown). Every change applies live.
[settings]
# anonymous | registered (a device can override it in its node config).
# listen_policy = "anonymous"

[settings.receiver]
# name = "MeshSDR"                       # station name (top bar, titles)
# location = "Lille, France"
# altitude_m = 0                         # antenna altitude, m (-500..9000)
# admin_email = "admin@example.org"
# admin_email_public = false
# gps = { lat = 50.63, lon = 3.06 }      # env: "50.63,3.06"
# country = "FR"                         # ISO 3166-1 alpha-2
# help_url = "https://example.org/help"
# photo_title = "View from the roof"
# photo_desc = "Markdown text"
# Usage policy shown at /policy, in Markdown (raw HTML is not rendered).
# Unset: the built-in default policy.
# usage_policy_text = """
# This receiver is open to everyone. Be nice.
# """
# usage_policy_url = "/policy"           # footer link: a path or an http(s) URL

[settings.bandplan]
# region = 0                             # IARU region 1, 2, 3, or 0 for all

[settings.ui]
# Theme mode: light | dark | auto (follows the visitor's prefers-color-scheme).
# A change applies on the next full page load.
# theme_mode = "auto"
# shortcut_set = "default"               # default | off
# tuning_precision = 2                   # 0..6 decimal digits
# recorder_enabled = true

[settings.ui.layout]
# side_panel_open = true
# default_tab = "decoders"               # decoders | bookmarks | info
# spectrum = false
# bandplan = true
# frequency_format = "radio"             # radio | locale

[settings.bookmarks]
# eibi_range_km = 0                      # 0 disables EIBi auto-bookmarks
# repeater_range_km = 0

[settings.session]
# idle_timeout = "24h"
# absolute_timeout = "24h"
# remember_me_timeout = "30d"            # "Keep me signed in"

[settings.auth]
# login_rate_limit = "5/1m"              # sign-in attempts per client address

[settings.auth.lockout]
# delay_after = 5                        # failures before progressive delays
# lock_after = 10                        # failures that lock the account
# lock_for = "15m"                       # doubled on each further failure
# max_lock = "24h"

[settings.retention]
# sessions = "30d"                       # ended sessions (at least 1d)
# audit_log = "365d"                     # audit log (at least 30d)
