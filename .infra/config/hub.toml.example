# MeshSDR hub configuration: /etc/meshsdr/hub.toml (TECHNICAL_SPEC §7.4).
#
# - TOML v1.0, declarative only. Every file (hub.toml and each hub.d/*.toml
#   drop-in, merged in lexical order) starts with schema_version.
# - Every key can be overridden by an env var: MESHSDR_<TABLE>__<KEY>, for
#   example db.dsn → MESHSDR_DB__DSN. Precedence: env > files > defaults.
#   Keys set in a file or the env are locked and shown with their origin.
# - The config dir is /etc/meshsdr, or --config-dir / MESHSDR_CONFIG_DIR.
# - JSON Schema: `meshsdr hub config schema`. Validate: `meshsdr hub config check`.
# - MESHSDR_PASSWORD is not a config key: it gives the password of
#   `meshsdr --noninteractive hub user add <name>`.
# - Secret keys take { file = "/etc/meshsdr/secrets/x" } or { env = "VAR" };
#   an inline value needs allow_inline_secrets = true in the same file.
#   Secret files must not be group/world-writable nor world-readable.
#
# Values below are the defaults unless marked "required".

schema_version = 1

[hub]
# Public base URL of the hub (required). Must be https unless
# allow_insecure_url = true.
url = "https://sdr.example.org"
# Allow a non-https url (development only).
allow_insecure_url = false

[gateway]
# The gateway owns every public port of the hub: it terminates TLS (HTTP/1.1
# and HTTP/2), serves the web UI and the API, and proxies the node media
# WebSockets (/nodes/<id>/ws) to the nodes over mTLS (ADR 0012, ADR 0021).
# Public TLS: acme (certificate for the host of hub.url from an ACME CA; the
# host must be a public DNS name reaching this gateway), files (tls_cert and
# tls_key below) or off (plain HTTP on http_listen, behind a TLS-terminating
# proxy or for development). On a LAN without a public name, use files with
# your own certificate, or off behind a reverse proxy that terminates TLS.
tls_mode = "acme"
# HTTPS listen address (unused with tls_mode = off). Binding :443 as a
# non-root user needs CAP_NET_BIND_SERVICE, or
# net.ipv4.ip_unprivileged_port_start=0 (Docker's default for containers).
# Otherwise listen on ":8443" (and http_listen on ":8080") and map
# 443 -> 8443 (80 -> 8080) in front of the hub.
https_listen = ":443"
# Plain HTTP listen address. With TLS it redirects to hub.url and answers
# ACME HTTP-01 challenges; with tls_mode = off it serves the hub. Empty: no
# plain listener (ACME then uses the TLS-ALPN challenge on https_listen).
# http_listen = ":80"
# Operator certificate chain and key (tls_mode = files), PEM. The key file
# must be mode 0600. Relative paths are resolved against the config dir.
# tls_cert = "tls/public.pem"
# tls_key = "tls/public.key"
# ACME account e-mail and directory (tls_mode = acme). Default directory:
# Let's Encrypt production.
# acme_email = "admin@example.org"
# acme_ca = "https://acme-staging-v02.api.letsencrypt.org/directory"
# ACME account and certificates (tls_mode = acme). Keep it on the data
# volume.
storage_dir = "/var/lib/meshsdr/acme"
# Maximum lifetime of a proxied node WebSocket. Node changes never restart
# the gateway.
stream_timeout = "24h"
# Request body limit of the API and of the node route.
max_body = "1MiB"

[db]
# Database DSN. Only SQLite is supported: sqlite:///abs/path or
# sqlite:relative/path, on a local filesystem.
dsn = "sqlite:///var/lib/meshsdr/hub.db"
# Size of the read-only connection pool (1..64).
max_read_connections = 4

# Hub internal CA for hub <-> node mTLS (ADR 0008). Create it with
# `meshsdr hub ca init` (writes tls/ca.pem and tls/ca.key in the config dir).
# Relative paths are resolved against the config dir. Without [tls] the hub
# runs with the grid disabled: no enrollment, no control channels. Under
# `meshsdr all` they default to tls/ca.pem and tls/ca.key, created at first
# start, and node.toml configures the local node (default id "local",
# listen 127.0.0.1:8074, certificate in tls/node.pem and tls/node.key).
# [tls]
# ca_cert = "tls/ca.pem"
# ca_key = { file = "tls/ca.key" }

# Nodes declared in the hub config (GRID-004): locked in Admin > Nodes and
# not deletable there. File-only: no env override. A node removed from the
# files becomes an admin-managed node.
# [nodes.attic]
# Base URL the hub dials (required): https://host:port.
# url = "https://10.8.0.12:8074"
# Display name (defaults to the node id).
# name = "Attic"
# Enrollment token (secret): 32 random bytes in unpadded base64url (43
# characters), e.g. `openssl rand -base64 32 | tr +/ -_ | tr -d =`, given to
# `meshsdr node enroll` on the node; used once.
# enrollment_token = { file = "/etc/meshsdr/secrets/node_attic.token" }

[log]
# debug | info | warn | error. --debug overrides it.
level = "info"
# text | json. --json overrides it.
format = "json"

[auth]
# Ed25519 keys that sign access tokens: one 0600 file per key in a 0700
# directory, written by the hub (rotation every key_rotation_days, or
# `meshsdr hub keys rotate`). Never in the database.
token_key_dir = "/var/lib/meshsdr/keys"
# Access token lifetime (1m to 10m).
token_ttl = "5m"
key_rotation_days = 30

[auth.argon2]
# Argon2id password hashing. Floors: memory_kib >= 19456, iterations >= 2.
# Stored hashes with other parameters are re-hashed at the next login.
memory_kib = 65536
iterations = 3
parallelism = 1

[admin]
# Client networks (CIDR) allowed to use the admin endpoints, checked on every
# admin request against the resolved client address. Default: any.
allowed_networks = ["0.0.0.0/0", "::/0"]

[smtp]
# Outgoing mail: invitations, password reset links and security notices.
# Without a host, mail is off: links are shown to the admin to copy.
# host = "smtp.example.org"
# port = 587
# starttls | implicit (verified certificates). none needs allow_insecure.
# tls = "starttls"
# username = "sdr@example.org"
# password = { file = "secrets/smtp_password" }
# from = "WebSDR <sdr@example.org>"

[http]
# Reverse proxies (CIDR) trusted for X-Forwarded-For. The client address is
# the right-most hop that is not a trusted proxy. Default: none.
trusted_proxies = []

# Admin settings (ADR 0010), MESHSDR_SETTINGS__<TABLE>__<KEY>. Each key set
# here or in the env is locked: read-only in the admin UI, which shows its
# origin. Leave a key commented out to keep it admin-editable (DB setting,
# then the default shown). Every change applies live.
[settings]
# anonymous | registered (a device can override it in its node config).
# listen_policy = "anonymous"
# Broadcast FM de-emphasis in µs: 50 (Europe, most of the world) or 75
# (Americas, South Korea). Pushed to the nodes.
# wfm_deemphasis = 50
# Audio sent to the listeners: adpcm (a quarter of the bandwidth) or pcm
# (uncompressed). Applies to receivers opened from now on.
# audio_compression = "adpcm"
# HF FAX decoder (Admin › Decoding, pushed to the nodes): line rate in
# lines per minute (30..480), shortest page saved to Files (50..450 lines),
# longest page (500..8000 lines), noise reduction, colour, AM instead of FM.
# fax_lpm = 120
# fax_min_length = 200
# fax_max_length = 1500
# fax_postprocess = true
# fax_color = false
# fax_am = false

[settings.receiver]
# name = "MeshSDR"                       # station name (top bar, titles)
# location = "Lille, France"
# altitude_m = 25                       # antenna altitude in metres (optional, published in the status)
# gps = { lat = 50.63, lon = 3.06 }      # env: "50.63,3.06"
# admin_email = "admin@example.org"      # contact e-mail
# admin_email_public = false             # true: published in GET /api/v1/status
# help_url = "https://example.org/help"
# photo_title = "View from the roof"
# photo_desc = "Markdown text"
# Usage policy shown at /policy, in Markdown (raw HTML is not rendered).
# Unset: the built-in default policy.
# usage_policy_text = """
# This receiver is open to everyone. Be nice.
# """
# usage_policy_url = "/policy"           # footer link: a path or an http(s) URL

[settings.privacy]
# Mask client addresses in Admin > Connections (IPv4 /24, IPv6 /48). An
# admin can reveal one address at a time; each reveal is audited.
# mask_ips = true

[settings.ui]
# Theme mode: light | dark | auto (follows the visitor's prefers-color-scheme).
# A change applies on the next full page load.
# theme_mode = "auto"
# shortcut_set = "default"               # default | off
# Record button and R shortcut of the receiver for every listener (REC-001;
# admins always have them). A convenience switch only: it cannot prevent
# recording, because the audio is streamed to the browser anyway.
# recorder_enabled = true

[settings.bandplan]
# IARU region of the band plan and of the region bookmark pack:
# r1 (Europe, Africa, Middle East) | r2 (Americas) | r3 (Asia, Pacific).
# region = "r1"

[settings.waterfall]
# Waterfall levels (dB, -200 to 50, min below max) and palette every
# receiver starts with (ADR 0026); listeners keep the Auto levels button.
# min_db = -88
# max_db = -20
# palette = "turbo"                      # default | turbo

[settings.session]
# idle_timeout = "24h"
# absolute_timeout = "24h"
# remember_me_timeout = "30d"            # "Keep me signed in"

[settings.auth]
# password_min_length = 10               # new passwords (8..256 characters)
# login_rate_limit = "5/1m"              # sign-in attempts per client address

[settings.auth.lockout]
# delay_after = 5                        # failures before progressive delays
# lock_after = 10                        # failures that lock the account
# lock_for = "15m"                       # doubled on each further failure
# max_lock = "24h"

[settings.retention]
# sessions = "30d"                       # ended sessions (at least 1d)
# audit_log = "365d"                     # audit log (at least 30d)
# connections = "30d"                    # closed presence rows (at least 1d)

[settings.files]
# retention_count = 20                   # newest files kept per kind (1..100000)
# retention_days = 0                     # maximum age in days (0: no age limit)
# max_total_bytes = 0                    # total size cap in bytes (0: no cap)

# Decoded messages (DEC-047): one age for every mode, plus a row cap.
[settings.retention.decoded_messages]
# max_age = "30d"                        # deleted after this long (at least 1d)
# max_rows = 1000000                     # the oldest beyond this many are deleted

[settings.grid]
# heartbeat_interval_s = 10              # node heartbeat period (1..300 s)
# offline_after_s = 60                   # offline without heartbeat (5..3600 s, > 2 heartbeats)

# Decoding (Admin › Decoding), pushed to the nodes in the desired state.
[settings.decoders]
# max_restarts = 5                       # unexpected exits within 5 min before a decoder gives up (1..100)
# digimodes_fft_size = 2048              # decoder waterfall FFT size of PSK, RTTY, SITOR-B, CW (512, 1024, 2048, 4096)
# cw_showcw = false                      # the CW decoder also prints dots and dashes
# wsjt_decoding_depth = 3                # WSJT-X decoding depth: 1 fast, 2 normal, 3 deep
# fst4_enabled_intervals = ["15", "30"]  # FST4 T/R periods (s): 15, 30, 60, 120, 300, 900, 1800
# fst4w_enabled_intervals = ["120", "300"] # FST4W T/R periods (s): 120, 300, 900, 1800
# q65_enabled_combinations = ["A30", "E120", "C60"] # Q65 submode + period, narrower than 2700 Hz
# js8_enabled_profiles = ["normal", "slow"] # JS8Call speeds: normal, slow, fast, turbo
# js8_decoding_depth = 3                 # JS8Call decoding depth (1..3)
# paging_filter = false                  # paging: keep only readable pages
# paging_charset = "US"                  # paging: POCSAG charset (US, FR, DE, DK, SE, SI)
# ism_report_levels = false              # ISM/WMBus: keep the signal levels of rtl_433

# Decoding depth per WSJT mode; 0: wsjt_decoding_depth.
[settings.decoders.wsjt_decoding_depths]
# ft8 = 0
# ft4 = 0
# jt65 = 1
# jt9 = 0
# wspr = 0                               # above 1, wsprd searches deeper (-d)
# fst4 = 0
# fst4w = 0
# q65 = 0

# Map (Admin › Map): base layers, lifetimes and report filtering.
[settings.map]
# Base layers offered: osm, opentopomap, esri_world_imagery,
# esri_world_street_map, esri_world_topo_map, cartodb_positron,
# cartodb_dark_matter, cartodb_voyager (default: all of them).
# base_layers = ["osm", "opentopomap", "cartodb_positron"]
# default_base_layer = "osm"             # one of base_layers
# position_retention_s = 7200            # positions and locators leave the map after this long (60..604800 s)
# max_calls = 5                          # call lines kept (0..100; 0: none)
# call_retention_s = 300                 # call line lifetime (10..86400 s)
# ignore_indirect_reports = false        # drop digipeated and third-party positions
# prefer_recent_reports = true           # drop a report older than the one shown
# precise_receivers = false              # false: station and receivers published at their 4-character locator (map, status; SR-32)

# Lookup links: an http(s) URL with exactly one {} placeholder (the
# URL-encoded value); empty: no link.
[settings.links]
# callsign_url = "https://www.qrzcq.com/call/{}"
# vessel_url = "https://www.vesselfinder.com/vessels/details/{}"
# flight_url = "https://flightaware.com/live/flight/{}"
# modes_url = "https://flightaware.com/live/modes/{}/redirect"
# sonde_url = "https://sondehub.org/{}"
# geoip_url = "https://www.geolocation.com/?ip={}#ipresult"

[settings.invitations]
# ttl_hours = 168                        # invitation link validity (1..720 hours)

[settings.password_reset]
# ttl_minutes = 30                       # reset link validity (5..1440 minutes)
