# MeshSDR node configuration: /etc/meshsdr/node.toml (TECHNICAL_SPEC §7.4).
#
# Same rules as hub.toml.example: schema_version in every file, node.d/*.toml
# drop-ins merged in lexical order, MESHSDR_<TABLE>__<KEY> env overrides
# (node.id → MESHSDR_NODE__ID). JSON Schema: `meshsdr node config schema`.
#
# Until it is enrolled (`meshsdr node enroll`), the node serves only the
# pre-enrollment API on node.listen, over TLS with an ephemeral self-signed
# certificate. Relative paths are resolved against the config dir.
#
# Values below are the defaults unless marked "required".

schema_version = 1

[node]
# Stable node id (required): ^[a-z0-9][a-z0-9-]{1,62}$. Must not change
# after enrollment.
id = "attic"
# Node API and WebSocket listen address (host:port). TLS only.
listen = "0.0.0.0:8074"
# Private runtime directory: absolute, mode 0700, owned by the node user
# (the node refuses to start otherwise). Per-tool workdirs live in its
# sessions/ subdirectory, swept at start. It is the only place the node
# writes (the images create it; use a tmpfs in other deployments).
runtime_dir = "/run/meshsdr-node"
# Loopback ports for the connector IQ and control sockets (lo-hi).
ipc_port_range = "40000-40999"
# TCP_NOTSENT_LOWAT of the node API sockets: bounds the kernel send
# buffering of media WebSockets so that slow listeners lose FFT frames
# instead of accumulating latency (ADR 0004).
ws_notsent_lowat = "16KiB"
# Demodulators the node runs at once, all devices together (interim
# default; devices.<id>.max_demods caps each device, default 16).
max_demods = 32

# RAM buffer of node events while the hub is unreachable; on overflow the
# node drops diagnostics, then map updates, then decodes (oldest first).
[node.event_buffer]
max_events = 10000
max_bytes = "16MiB"

# Node certificate and key, written by `meshsdr node enroll` (key 0600) and
# rewritten when the hub renews the certificate. Relative to the config dir
# (in the image, /etc/meshsdr/tls is on the data volume).
[tls]
cert = "tls/node.pem"
key = "tls/node.key"

# Trust in the hub.
[hub_trust]
# Hub CA certificate, written by `meshsdr node enroll`.
ca_cert = "tls/ca.pem"
# SHA-256 fingerprint of the hub CA, shown by the hub with the token.
# ca_fingerprint = "AB:CD:…"
# Expected hub id (host of the hub's hub.url); empty accepts any hub
# certificate from the CA.
# hub_identity = "sdr.example.org"
# Single-use enrollment token issued by the hub (secret).
# enrollment_token = { file = "/etc/meshsdr/secrets/enrollment.token" }

# External programs. A tool is its tools.<name> absolute path when set,
# otherwise found by name in tools.dirs, which is also the PATH of every
# tool (the node's own PATH is never used). The node image ships
# rtl_connector, rtl_tcp_connector (owrx_connector) and csdr-cwskimmer in
# /usr/local/bin, and the decoders jt9, wsprd (wsjtx), js8 (js8call),
# direwolf, multimon-ng and rtl_433 in /usr/bin. The node probes the
# decoders at start and when the hub asks (DEC-001): a missing one makes
# its digital modes unavailable.
[tools]
dirs = ["/usr/local/bin", "/usr/bin"]
# rtl_connector = "/usr/local/bin/rtl_connector"
# rtl_tcp_connector = "/usr/local/bin/rtl_tcp_connector"
# jt9 = "/usr/bin/jt9"
# wsprd = "/usr/bin/wsprd"
# js8 = "/usr/bin/js8"
# direwolf = "/usr/bin/direwolf"
# multimon_ng = "/usr/bin/multimon-ng"
# rtl_433 = "/usr/bin/rtl_433"
# csdr_cwskimmer = "/usr/local/bin/csdr-cwskimmer"

# Decoder resources of this node. The decoding settings are hub settings
# (Admin › Decoding), pushed to the node.
[decoders]
# Workers of the batch decoders (WSJT family and JS8), shared by every
# session; 0: half the CPU cores (at least 1).
batch_workers = 0
# Batch decoder jobs waiting for a worker; on overflow the oldest is
# dropped.
#
# Disk: a batch session records each slot period as a 12 kHz 16-bit WAV
# in its workdir under node.runtime_dir (24 kB per second of slot): 360 kB
# for an FT8 slot, 2.9 MB for WSPR, up to 43 MB for a 1800 s FST4 slot,
# plus the slots waiting in the queue (removed once decoded). A
# runtime_dir on tmpfs (/run) keeps them in RAM: size it for the sessions
# and periods you allow.
queue_length = 10
# Decoder sessions the node runs at once, all listeners together; beyond
# it a listener's decoder is unavailable ("node busy"). 0: twice the CPU
# cores.
max_sessions = 0

# Limits of every external decoder process (DEC-048), applied between fork
# and exec. Each decoder runs in its own workdir under node.runtime_dir,
# argv only, and is restarted with back-off when it fails.
[decoders.process_limits]
# CPU niceness (0..19): the DSP keeps the priority.
nice = 10
# Open-files limit (RLIMIT_NOFILE).
open_files = 1024
# Address-space limit (RLIMIT_AS); "0" (none) leaves the memory cap to the
# deployment (docker run --memory). Tools built with Go or with many
# threads need 1GiB or more.
memory = "0"

# USB devices in a container: pass the bus (compose
# devices: ["/dev/bus/usb:/dev/bus/usb"]) and the group owning it to the
# nonroot user (group_add: ["<gid>"]); blacklist the dvb_usb_rtl28xxu
# kernel driver on the host. rtl_tcp devices need no USB access.

# SDR devices of this node (GRID-016), keyed by a hub-wide unique id
# (^[a-z0-9][a-z0-9_-]{0,62}$). The hub mirrors them read-only into its
# device registry; they are configured here only. File-only: no env
# override. This node runs rtl_sdr and rtl_tcp devices; other types are
# reported as unavailable. A device starts when a listener attaches (or
# with always_on) and stops 10 s after the last one leaves. Without
# presets, it starts at center_freq and sample_rate (default: the first
# sample rate, with the capture band at the bottom of freq_range);
# operators (operator_can_retune) and admins retune it from the receiver.
# A device whose driver, center_freq or sample_rate keys are invalid does
# not stop the node: it is logged and reported failed (invalid_config).
# [devices.vhf-rtl]
# name = "RTL-SDR (2 m)"             # required
# type = "rtl_sdr"                   # required: rtl_sdr (USB) | rtl_tcp (remote rtl_tcp server)
# enabled = true                     # default true
# freq_range = { min = "24MHz", max = "1766MHz" }  # required (Hz or units)
# sample_rates = [2_400_000, 1_024_000]            # required (S/s)
# center_freq = "145MHz"             # start tuning, within freq_range
# sample_rate = 2_400_000            # start rate, one of sample_rates
# listen_policy = "anonymous"        # anonymous | registered (overrides the global policy)
# operator_can_retune = true
# always_on = true
# scheduler_enabled = true
# auto_recover = true                # restart a failed device every 15 min
# max_demods = 16                    # demodulators of this device at once
# [devices.vhf-rtl.driver]
# device = "0"                       # rtl_sdr: device index or serial (default 0); rtl_tcp: host:port
# ppm = 1                            # frequency correction (-1000..1000)
# rf_gain = 29.7                     # auto (AGC, default) | dB
# iqswap = false                     # swap I and Q (reversed spectrum)
# bias_tee = false                   # power an active antenna or LNA
# direct_sampling = "off"            # off | i | q (HF without upconverter)
# lfo_offset = 0                     # converter LO in Hz, signed: the hardware tunes to centre + lfo_offset
#
# Soapy devices come with M1b (SRC-015): this node does not support them
# yet and reports them unavailable (driver_unsupported).
# [devices.hf-sdrplay]
# name = "SDRplay RSPdx (HF)"
# type = "soapy:sdrplay"
# freq_range = { min = 1_000, max = "30MHz" }
# sample_rates = [500_000, 2_000_000]
# listen_policy = "registered"

[log]
# debug | info | warn | error. --debug overrides it.
level = "info"
# text | json. --json overrides it.
format = "json"
